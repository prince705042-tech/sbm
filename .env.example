# ==============================================================================
# SWACHH CAMPUS - NIT PATNA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - Never commit real credentials, service role keys, or database secrets to version control.
# - Only variables prefixed with VITE_ are exposed to the client-side JavaScript bundle.
# - SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with VITE_ or exposed to the client.
# ==============================================================================

# Supabase PostgreSQL Cloud URL (Public HTTPS endpoint)
# e.g., https://your-project-id.supabase.co
VITE_SUPABASE_URL=

# Supabase Anonymous Client Public Key (Safe for browser with Row Level Security enabled)
# e.g., eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 Measurement ID (Optional)
# e.g., G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=